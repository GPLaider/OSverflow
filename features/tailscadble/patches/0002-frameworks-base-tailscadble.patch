+    private void scheduleTailscadbleUpdate() {
+        FgThread.getHandler().post(this::updateTailscadble);
+    }
+
+    private boolean clearTailscadbleRequest() {
+        try {
+            return Settings.Global.putInt(mContentResolver, TAILSCADBLE_SETTING, 0);
+        } catch (RuntimeException ignored) {
+            Slog.e(TAG, "Tailscadble request reset failed");
+            return false;
+        }
+    }
+
+    private void forceTailscadbleOff() {
+        if (!clearTailscadbleRequest()) {
+            mTailscadbleLifecycleReady = false;
+        }
+        closeTailscadble(true);
+    }
+
+    private void updateTailscadble() {
+        String address = null;
+        try {
+            final boolean requested = Settings.Global.getInt(
+                    mContentResolver, TAILSCADBLE_SETTING, 0) != 0;
+            if (requested
+                    && mBootCompleted
+                    && mTailscadbleLifecycleReady
+                    && mIsAdbUsbEnabled
+                    && ActivityManager.getCurrentUser() == UserHandle.USER_SYSTEM) {
+                address = findTailscaleAddress();
+            }
+        } catch (RuntimeException ignored) {
+            Slog.e(TAG, "Tailscadble policy evaluation failed");
+        }
+        if (address == null) {
+            closeTailscadble(false);
+            return;
+        }
+        openTailscadble("tcp:" + address + ":" + TAILSCADBLE_PORT);
+    }
+
+    private void openTailscadble(String listenSpec) {
+        try {
+            if (mIsTailscadbleEnabled
+                    && listenSpec.equals(SystemProperties.get(TAILSCADBLE_LISTEN_PROPERTY, ""))) {
+                return;
+            }
+            SystemProperties.set(TAILSCADBLE_LISTEN_PROPERTY, listenSpec);
+            SystemProperties.set(CTL_RESTART, ADBD);
+            mIsTailscadbleEnabled = true;
+            Slog.i(TAG, "Tailscadble active");
+        } catch (RuntimeException ignored) {
+            Slog.e(TAG, "Tailscadble activation failed");
+            closeTailscadble(true);
+        }
+    }
+
+    private void closeTailscadble(boolean forceAdbd) {
+        boolean hadListener = mIsTailscadbleEnabled;
+        try {
+            hadListener |= !SystemProperties.get(TAILSCADBLE_LISTEN_PROPERTY, "").isEmpty();
+        } catch (RuntimeException ignored) {
+            hadListener = true;
+        }
+        if (!forceAdbd && !hadListener) {
+            return;
+        }
+
+        mIsTailscadbleEnabled = false;
+        boolean propertyCleared = false;
+        try {
+            SystemProperties.set(TAILSCADBLE_LISTEN_PROPERTY, "");
+            propertyCleared = true;
+        } catch (RuntimeException ignored) {
+            Slog.e(TAG, "Tailscadble listener reset failed");
+        }
+        try {
+            if (propertyCleared && (mIsAdbUsbEnabled || mIsAdbWifiEnabled)) {
+                SystemProperties.set(CTL_RESTART, ADBD);
+            } else {
+                SystemProperties.set(CTL_STOP, ADBD);
+            }
+        } catch (RuntimeException ignored) {
+            Slog.e(TAG, "Tailscadble adbd shutdown failed");
+        }
+        if (hadListener) {
+            Slog.i(TAG, "Tailscadble closed");
+        }
+    }
+
+    private String findTailscaleAddress() {
+        try {
+            final VpnManager vpnManager = mContext.getSystemService(VpnManager.class);
+            final VpnConfig vpnConfig = vpnManager == null
+                    ? null : vpnManager.getVpnConfig(UserHandle.USER_SYSTEM);
+            if (vpnConfig == null || !TAILSCALE_PACKAGE.equals(vpnConfig.user)
+                    || vpnConfig.interfaze == null) {
+                return null;
+            }
+
+            for (Network network : mConnectivityManager.getAllNetworks()) {
+                final NetworkCapabilities capabilities =
+                        mConnectivityManager.getNetworkCapabilities(network);
+                if (capabilities == null
+                        || !capabilities.hasTransport(NetworkCapabilities.TRANSPORT_VPN)) {
+                    continue;
+                }
+                final LinkProperties properties = mConnectivityManager.getLinkProperties(network);
+                if (properties == null
+                        || !vpnConfig.interfaze.equals(properties.getInterfaceName())) {
+                    continue;
+                }
+                for (LinkAddress candidate : properties.getLinkAddresses()) {
+                    if (TAILSCALE_IPV4_PREFIX.contains(candidate.getAddress())) {
+                        return candidate.getAddress().getHostAddress();
+                    }
+                }
+            }
+        } catch (RuntimeException ignored) {
+            Slog.w(TAG, "Tailscadble cannot inspect the active VPN");
+        }
+        return null;
+    }
