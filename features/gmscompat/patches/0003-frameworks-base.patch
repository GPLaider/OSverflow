+    private static boolean shouldHideDisabledState(String pkgName) {
+        if (!GmsCompat.isPlayStore()) {
+            return false;
+        }
+
+        switch (pkgName) {
+            case GmsInfo.PACKAGE_GMS_CORE:
+                return false;
+            default:
+                return true;
+        }
+    }
