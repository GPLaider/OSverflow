+    private static <T extends Parcelable> T cloneViaParcel(T obj, Parcelable.Creator<T> creator) {
+        Parcel p = Parcel.obtain();
+        obj.writeToParcel(p, 0);
+        p.setDataPosition(0);
+        T res = creator.createFromParcel(p);
+        p.recycle();
+        return res;
