+
+    private void removeStaticOwnershipCollisions(Set<Long> deviceConfigOwnedIds) {
+        for (Profile profile : mStaticProfiles) {
+            Set<Long> collisions = new ArraySet<>(profile.ownedChangeIds());
+            collisions.retainAll(deviceConfigOwnedIds);
+            if (!collisions.isEmpty()) {
+                removePackageOverrides(profile.packageName(), profile.ownedChangeIds());
+            }
+        }
+    }
+
+    private void scheduleStaticProfileExpiry() {
+        AlarmManager alarmManager = mAlarmManager;
+        if (alarmManager == null) {
+            return;
+        }
+        alarmManager.cancel(mStaticProfileExpiryListener);
+
+        long now = System.currentTimeMillis();
+        long nextExpiry = Long.MAX_VALUE;
+        for (Profile profile : mStaticProfiles) {
+            if (!profile.retired() && profile.expiresAtMillis() > now) {
+                nextExpiry = Math.min(nextExpiry, profile.expiresAtMillis());
+            }
+        }
+        if (nextExpiry != Long.MAX_VALUE) {
+            alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, nextExpiry, TAG,
+                    mContext.getMainExecutor(), null, mStaticProfileExpiryListener);
+        }
+    }
