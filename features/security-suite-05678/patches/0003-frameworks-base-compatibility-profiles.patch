+    private void applyStaticProfile(Profile profile, Set<Long> deviceConfigOwnedIds) {
+        if (!Collections.disjoint(profile.ownedChangeIds(), deviceConfigOwnedIds)) {
+            Slog.e(TAG, "Rejecting OSverflow profile with DeviceConfig-owned change ID: "
+                    + profile.packageName());
+            removePackageOverrides(profile.packageName(), profile.ownedChangeIds());
+            return;
+        }
+
+        Map<Long, PackageOverride> overridesToAdd = emptyMap();
+        if (profile.getApplicability(mPackageManager, System.currentTimeMillis())
+                == Applicability.ACTIVE) {
+            Long versionCode = getVersionCodeOrNull(profile.packageName());
+            if (versionCode != null) {
+                overridesToAdd = mOverridesParser.parsePackageOverrides(
+                        profile.toPlatformConfigString(), profile.packageName(), versionCode,
+                        emptySet());
+            }
