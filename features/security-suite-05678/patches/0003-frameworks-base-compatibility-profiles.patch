+
+        if (!overridesToAdd.keySet().equals(profile.overrides().keySet())) {
+            overridesToAdd = emptyMap();
+        }
+        putPackageOverrides(profile.packageName(), overridesToAdd);
+
+        Set<Long> overridesToRemove = new ArraySet<>(profile.ownedChangeIds());
+        overridesToRemove.removeAll(overridesToAdd.keySet());
+        removePackageOverrides(profile.packageName(), overridesToRemove);
+    }
+
+    private void applyStaticProfile(String packageName) {
+        Set<Long> deviceConfigOwnedIds = getAllDeviceConfigOwnedChangeIds();
+        for (Profile profile : mStaticProfiles) {
